generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Trip {
  id             String    @id @default(cuid())
  name           String
  destination    String?
  startDate      DateTime?
  endDate        DateTime?
  status         String    @default("planned") // planned | booked | active | past | cancelled
  travelers      String[]  @default([])
  transport      String?
  accommodation  String?
  costUsd        Float?
  bookingUrl     String?
  notes          String?
  imageUrl       String?
  // "What I'm doing on this trip" — drives AI packing-list generation; saved
  // so regenerate and the tuning chat reuse it.
  packingContext String?
  archived       Boolean   @default(false)
  position       Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  items        TripItem[]
  packingItems PackingItem[]

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, archived, startDate])
  @@index([userId])
}

model TripItem {
  id           String    @id @default(cuid())
  tripId       String
  trip         Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  kind         String // "flight" | "lodging" | "activity" | "transport" | "meal" | "note" | "task"
  title        String
  startAt      DateTime?
  endAt        DateTime?
  location     String?
  fromLocation String?
  toLocation   String?
  confirmation String?
  url          String?
  costUsd      Float?
  notes        String?
  completedAt  DateTime?
  position     Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tripId, startAt, position])
  @@index([userId])
}

model PackingItem {
  id        String    @id @default(cuid())
  tripId    String
  trip      Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  title     String
  category  String    @default("Other") // Clothing | Toiletries | Electronics | Documents | Gear | Other (free-form)
  quantity  Int       @default(1)
  packedAt  DateTime? // set = checked off
  notes     String? // AI's "why", e.g. "rain expected Tue"
  position  Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tripId, category, position])
  @@index([userId])
}

model List {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("zinc") // tailwind color name
  position  Int      @default(0)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  todos   Todo[]
  members ListMember[]

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([position])
  @@index([userId])
}

// Collaborative-list membership. Owners stay on List.userId; members on
// non-default lists can view + edit todos via this join table. Default
// lists (isDefault = true) are never shared — every account has its own.
model ListMember {
  id        String   @id @default(cuid())
  listId    String
  list      List     @relation(fields: [listId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("editor") // future: "viewer" | "admin"
  // Member's personal tile color for this list. Null = inherit the owner's
  // List.color. Lets a member recolor a shared tile without repainting it
  // for everyone else.
  color     String?
  createdAt DateTime @default(now())

  @@unique([listId, userId])
  @@index([userId])
  @@index([listId])
}

model Project {
  id        String   @id @default(cuid())
  name      String
  icon      String   @default("Folder")
  color     String   @default("neutral")
  position  Int      @default(0)
  archived  Boolean  @default(false)
  kind      String   @default("generic") // "generic" | "vehicle"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  todos        Todo[]
  notes        Note[]
  attachments  Attachment[]
  vehicle      Vehicle?
  pet          Pet?
  human        Human?
  assets       Asset[]
  interactions Interaction[]

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([archived, position])
  @@index([userId])
}

model Vehicle {
  id        String  @id @default(cuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Identity
  make           String
  model          String
  year           Int
  vin            String?
  chassisNumber  String?
  engineNumber   String?
  assemblyNumber String?
  marketSpec     String?
  bodyStyle      String?
  exteriorColor  String?
  interiorColor  String?
  transmission   String?

  // Acquisition
  acquiredAt       DateTime?
  acquiredFrom     String?
  acquiredPriceUsd Float?
  acquiredMileage  Int?

  // Current state
  currentMileage Int?
  mileageUnit    String @default("km") // "km" | "mi"

  // Long-form text
  notes String?

  // Reference data (JSON arrays of {label, value, ...})
  fluidSpecs       Json?
  partNumbers      Json?
  performanceSpecs Json?

  // Insurance
  insurer         String?
  policyNumber    String?
  policyEffective DateTime?
  policyExpires   DateTime?
  insurerPhone    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  serviceItems    ServiceItem[]
  serviceRecords  ServiceRecord[]
  contacts        VehicleContact[]
  photos          VehiclePhoto[]
  shoppingItems   ShoppingItem[]
  drives          VehicleDrive[]
  recommendations Recommendation[]

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VehiclePhoto {
  id        String  @id @default(cuid())
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  url      String
  mimeType String?
  size     Int?
  width    Int?
  height   Int?
  caption  String?

  position  Int      @default(0)
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([vehicleId, position])
  @@index([userId])
}

model ShoppingItem {
  id        String  @id @default(cuid())
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  title       String
  link        String?
  priceUsd    Float?
  quantity    Int?      @default(1)
  notes       String?
  completedAt DateTime?

  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([vehicleId, completedAt, position])
  @@index([userId])
}

model Human {
  id        String  @id @default(cuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Identity
  fullName              String
  sex                   String? // "M" | "F"
  birthDate             DateTime?
  bloodType             String?
  heightInches          Float?
  primaryCarePhysician  String?
  pcpPhone              String?
  insurer               String?
  insurerPhone          String?
  policyNumber          String?
  emergencyContactName  String?
  emergencyContactPhone String?

  // Reference (JSON arrays)
  allergiesJson   Json? // [{ allergen, severity, notes }]
  medicationsJson Json? // [{ name, dosage, frequency, prescribedBy, since }]
  conditionsJson  Json? // [{ name, diagnosedAt, notes }]

  // AI-generated lifestage / what-to-watch note (regenerated on demand)
  lifeStageNote   String?
  lifeStageNoteAt DateTime?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  biometrics      BiometricReading[]
  labResults      LabResult[]
  medicalVisits   MedicalVisit[]
  vaccinations    HumanVaccination[]
  fitnessSessions FitnessSession[]
  dnaResults      DnaResult[]
  recommendations Recommendation[]

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model BiometricReading {
  id      String @id @default(cuid())
  humanId String
  human   Human  @relation(fields: [humanId], references: [id], onDelete: Cascade)

  measuredAt DateTime
  kind       String // "weight" | "bodyFat" | "bp" | "rhr" | "vo2" | "hrv" | "fastingGlucose" | "waist" | etc
  value      Float
  unit       String // "lb" | "%" | "mmHg" | "bpm" | etc
  source     String? // "manual" | "oura" | "withings" | "apple-health"
  notes      String?

  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([humanId, kind, measuredAt])
  @@index([userId])
}

model LabResult {
  id      String @id @default(cuid())
  humanId String
  human   Human  @relation(fields: [humanId], references: [id], onDelete: Cascade)

  drawnAt DateTime
  panel   String // "CBC" | "CMP" | "lipid" | "thyroid" | "hormone" | etc
  marker  String // "LDL" | "HDL" | "A1c" | "ferritin" | etc
  value   Float
  unit    String
  refLow  Float?
  refHigh Float?
  flag    String? // "low" | "normal" | "high"
  notes   String?

  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([humanId, marker, drawnAt])
  @@index([userId])
}

model MedicalVisit {
  id      String @id @default(cuid())
  humanId String
  human   Human  @relation(fields: [humanId], references: [id], onDelete: Cascade)

  performedAt  DateTime
  providerName String
  specialty    String? // "primary" | "cardiology" | "dental" | "derm" | etc
  reason       String
  summary      String?
  costUsd      Float?
  followUpAt   DateTime?

  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([humanId, performedAt])
  @@index([userId])
}

model HumanVaccination {
  id      String @id @default(cuid())
  humanId String
  human   Human  @relation(fields: [humanId], references: [id], onDelete: Cascade)

  name           String
  administeredAt DateTime
  boosterDueAt   DateTime?
  provider       String?
  notes          String?

  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([humanId, administeredAt])
  @@index([userId])
}

model FitnessSession {
  id      String @id @default(cuid())
  humanId String
  human   Human  @relation(fields: [humanId], references: [id], onDelete: Cascade)

  performedAt  DateTime
  kind         String // "run" | "lift" | "cardio" | "yoga" | "ride" | "hike"
  durationMin  Int?
  distanceMi   Float?
  caloriesKcal Int?
  avgHr        Int?
  maxHr        Int?
  notes        String?
  source       String? // "manual" | "strava" | "apple-health"

  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([humanId, performedAt])
  @@index([userId])
}

model DnaResult {
  id      String @id @default(cuid())
  humanId String
  human   Human  @relation(fields: [humanId], references: [id], onDelete: Cascade)

  category String // "ancestry" | "trait" | "health-risk" | "carrier" | "pharma"
  title    String
  finding  String
  detail   String?
  source   String? // "23andMe" | "Ancestry" | "Color"

  reportedAt DateTime?
  createdAt  DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([humanId, category])
  @@index([userId])
}

model Pet {
  id        String  @id @default(cuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name        String
  species     String    @default("dog") // "dog" | "cat" | "other"
  breed       String?
  sex         String? // "F" | "M"
  color       String?
  birthDate   DateTime?
  microchipId String?

  spayedNeuteredAt DateTime?

  feedingSchedule String?
  notes           String?

  // Claude-generated breed+age-specific guidance, regenerated on demand.
  lifeStageNote   String?
  lifeStageNoteAt DateTime?

  // Reference (JSON arrays)
  allergies   Json?
  medications Json? // [{ name, dosage, frequency }]

  // Vet
  vetClinic  String?
  vetPhone   String?
  vetAddress String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  weights         PetWeight[]
  vaccinations    PetVaccination[]
  vetVisits       PetVetVisit[]
  photos          PetPhoto[]
  shoppingItems   PetShoppingItem[]
  recommendations Recommendation[]

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PetWeight {
  id    String @id @default(cuid())
  petId String
  pet   Pet    @relation(fields: [petId], references: [id], onDelete: Cascade)

  measuredAt DateTime
  weightLb   Float
  notes      String?

  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([petId, measuredAt])
  @@index([userId])
}

model PetVaccination {
  id    String @id @default(cuid())
  petId String
  pet   Pet    @relation(fields: [petId], references: [id], onDelete: Cascade)

  name           String
  administeredAt DateTime
  boosterDueAt   DateTime?
  vet            String?
  notes          String?

  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([petId, administeredAt])
  @@index([userId])
}

model PetVetVisit {
  id    String @id @default(cuid())
  petId String
  pet   Pet    @relation(fields: [petId], references: [id], onDelete: Cascade)

  performedAt DateTime
  reason      String
  vet         String?
  details     String?
  costUsd     Float?

  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([petId, performedAt])
  @@index([userId])
}

model PetPhoto {
  id    String @id @default(cuid())
  petId String
  pet   Pet    @relation(fields: [petId], references: [id], onDelete: Cascade)

  url      String
  mimeType String?
  size     Int?
  width    Int?
  height   Int?
  caption  String?

  position  Int      @default(0)
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([petId, position])
  @@index([userId])
}

model Recommendation {
  id        String   @id @default(cuid())
  scope     String // "pet" | "vehicle" | "human"
  petId     String?
  vehicleId String?
  humanId   String?
  pet       Pet?     @relation(fields: [petId], references: [id], onDelete: Cascade)
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  human     Human?   @relation(fields: [humanId], references: [id], onDelete: Cascade)

  title    String
  body     String?
  priority String  @default("normal") // "high" | "normal" | "low"
  cadence  String? // "weekly" | "monthly" | "seasonal" | "one-time"

  generatedAt DateTime  @default(now())
  completedAt DateTime?
  dismissedAt DateTime?

  position Int @default(0)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([petId, completedAt, dismissedAt, position])
  @@index([vehicleId, completedAt, dismissedAt, position])
  @@index([humanId, completedAt, dismissedAt, position])
  @@index([userId])
}

model PetShoppingItem {
  id    String @id @default(cuid())
  petId String
  pet   Pet    @relation(fields: [petId], references: [id], onDelete: Cascade)

  title       String
  link        String?
  priceUsd    Float?
  quantity    Int?      @default(1)
  notes       String?
  completedAt DateTime?

  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([petId, completedAt, position])
  @@index([userId])
}

model ServiceItem {
  id        String  @id @default(cuid())
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  name            String
  intervalMonths  Int?
  intervalMileage Int?
  notes           String?

  lastPerformedAt      DateTime?
  lastPerformedMileage Int?

  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([vehicleId, position])
  @@index([userId])
}

model ServiceRecord {
  id        String  @id @default(cuid())
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  performedAt DateTime
  mileage     Int?
  shop        String?
  workSummary String
  details     String?
  costUsd     Float?

  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([vehicleId, performedAt])
  @@index([userId])
}

model VehicleContact {
  id        String  @id @default(cuid())
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  name    String
  role    String?
  address String?
  phone   String?
  email   String?
  website String?
  notes   String?

  position  Int      @default(0)
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([vehicleId, position])
  @@index([userId])
}

model VehicleDrive {
  id        String  @id @default(cuid())
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  drivenAt    DateTime
  distance    Int
  destination String?
  notes       String?

  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([vehicleId, drivenAt])
  @@index([userId])
}

model Note {
  id        String   @id @default(cuid())
  title     String?
  body      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId, updatedAt])
  @@index([userId])
}

model Attachment {
  id        String   @id @default(cuid())
  kind      String // "file" | "link"
  title     String
  url       String
  mimeType  String?
  size      Int?
  createdAt DateTime @default(now())

  // Polymorphic owner: an attachment belongs to exactly one of a project, a todo, or an asset.
  // All FKs are nullable; the API layer enforces "exactly one set".
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  todoId String?
  todo   Todo?   @relation(fields: [todoId], references: [id], onDelete: Cascade)

  assetId String?
  asset   Asset?  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([assetId, createdAt])
  @@index([todoId, createdAt])
  @@index([userId])
}

model Person {
  id                String    @id @default(cuid())
  externalId        String?   @unique // Airtable record ID
  firstName         String
  lastName          String?
  strength          String? // "close" | "strong" | "casual" | "weak"
  circles           String[]  @default([])
  tags              String[]  @default([])
  email             String?
  phone             String?
  company           String?
  role              String?
  city              String?
  country           String?
  // { linkedin?, twitter?, instagram?, github?, website? } — open shape so
  // we can add platforms without migrations.
  socialUrls        Json?
  howWeMet          String?
  interests         String[]  @default([])
  birthday          DateTime?
  lastInteractionAt DateTime?
  notes             String?
  imageUrl          String?
  starred           Boolean   @default(false)
  archived          Boolean   @default(false)
  position          Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, archived, starred, lastInteractionAt])
  @@index([userId])
}

// Generic life-tracking record. One model powers many lightweight pages
// (investments, inventory, media, places, best practices). The `kind` field
// scopes records to a page; structured fields cover most use cases without
// needing a bespoke schema per domain.
model Asset {
  attachments Attachment[]
  id          String       @id @default(cuid())
  kind        String // "investment" | "inventory" | "media" | "place" | "practice"
  externalId  String? // e.g. Airtable record ID (rec...) — used for upserts
  title       String
  subtitle    String?
  category    String? // user-defined (e.g. "venture", "watch", "book", "restaurant")
  status      String? // "active" | "exited" | "wishlist" | "owned" | "visited" | etc

  // Money
  amountUsd     Float?
  currentValue  Float?
  costBasis     Float?
  currency      String? @default("USD")
  // Expected return as a percentage (e.g. 2400 = 2400%). Sourced from
  // Airtable's `Return` formula when available, otherwise computed locally.
  returnPercent Float?

  // Common metadata
  acquiredAt  DateTime?
  exitedAt    DateTime?
  rating      Int? // 1-5
  url         String?
  imageUrl    String?
  location    String?
  tagsJson    Json?
  detailsJson Json? // free-form structured data
  notes       String?

  position  Int      @default(0)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@unique([kind, externalId])
  @@index([userId, kind, archived, position])
  @@index([userId])
  @@index([projectId])
}

model Todo {
  id          String    @id @default(cuid())
  title       String
  notes       String?
  dueDate     DateTime?
  completedAt DateTime?
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Stable key for cron-generated todos (e.g. "vehicle:abc:service:oil-30d").
  // Lets renewal-autopilot dedupe by key lookup instead of regex-scanning
  // every open todo's notes field on every tick.
  autopilotKey String?

  // Decay states. Dropped ("decided not to do") and Reference ("not a task")
  // also set completedAt so every open-list filter excludes them for free;
  // droppedAt / isReference distinguish them from real completions.
  droppedAt    DateTime?
  isReference  Boolean   @default(false)
  // Snoozed todos are hidden from list reads until this passes, then
  // resurface with a chip. Relative options only — never a date picker.
  snoozedUntil DateTime?

  // 1:1 agenda mode (person-lists): when this item was last marked
  // "discussed", and how many meetings it has survived.
  lastDiscussedAt DateTime?
  discussCount    Int       @default(0)

  listId String
  list   List   @relation(fields: [listId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  parentId String?
  parent   Todo?   @relation("TodoSubtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks Todo[]  @relation("TodoSubtasks")

  attachments  Attachment[]
  comments     Comment[]
  commentReads CommentRead[]

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, autopilotKey])
  @@index([listId, completedAt, position])
  @@index([projectId, completedAt, position])
  @@index([parentId, completedAt, position])
  @@index([userId])
}

// ─── Auth ──────────────────────────────────────────────────────────

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String?
  createdAt      DateTime @default(now())
  lastSeenAt     DateTime @default(now())
  kindleEmail    String?
  kindleAutoSend Boolean  @default(true)

  // auto-generated back-references
  pushSubscriptions PushSubscription[]
  readerItems       ReaderItem[]
  boardItems        BoardItem[]
  boardTaste        BoardTaste?
  boardRecs         BoardRec[]
  highlights        Highlight[]
  trips             Trip[]
  tripItems         TripItem[]
  packingItems      PackingItem[]
  lists             List[]
  projects          Project[]
  vehicles          Vehicle[]
  vehiclePhotos     VehiclePhoto[]
  shoppingItems     ShoppingItem[]
  humans            Human[]
  biometricReadings BiometricReading[]
  labResults        LabResult[]
  medicalVisits     MedicalVisit[]
  humanVaccinations HumanVaccination[]
  fitnessSessions   FitnessSession[]
  dnaResults        DnaResult[]
  pets              Pet[]
  petWeights        PetWeight[]
  petVaccinations   PetVaccination[]
  petVetVisits      PetVetVisit[]
  petPhotos         PetPhoto[]
  recommendations   Recommendation[]
  petShoppingItems  PetShoppingItem[]
  serviceItems      ServiceItem[]
  serviceRecords    ServiceRecord[]
  vehicleContacts   VehicleContact[]
  vehicleDrives     VehicleDrive[]
  notes             Note[]
  attachments       Attachment[]
  persons           Person[]
  assets            Asset[]
  todos             Todo[]
  interactions      Interaction[]
  personalRecord    PersonalRecord?
  listMemberships   ListMember[]
  comments          Comment[]
  commentReads      CommentRead[]
  datingPeople      DatingPerson[]
  datingEvents      DatingEvent[]
  datingMessages    DatingMessage[]

  @@index([email])
}

// Threaded comments on a task. Visible to everyone who can access the todo's
// list (owner + ListMembers), so collaborators on a shared list can discuss a
// task. Flat chronological thread — no nested replies.
model Comment {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  todoId   String
  todo     Todo   @relation(fields: [todoId], references: [id], onDelete: Cascade)
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([todoId, createdAt])
}

// Per-(user, todo) read marker. Unread badge = comments on the todo authored by
// someone else with createdAt newer than this user's lastReadAt.
model CommentRead {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  todoId     String
  todo       Todo     @relation(fields: [todoId], references: [id], onDelete: Cascade)
  lastReadAt DateTime @default(now())

  @@unique([userId, todoId])
  @@index([userId])
}

// Birth certificate / passport / parents — formerly hard-coded in
// src/lib/personal.ts. Stored per-user in the DB so PII never lives in
// source. Only the founder populates this today; other tenants see an
// empty state on /personal.
model PersonalRecord {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Timestamped log of social interactions — replaces relying on
// Person.lastInteractionAt as the only signal. One row per encounter, with
// optional people / project / photo links.
model Interaction {
  id         String   @id @default(cuid())
  occurredAt DateTime
  kind       String // "dinner" | "call" | "meeting" | "event" | "message" | "other"
  title      String
  location   String?
  notes      String?
  photoUrl   String?
  personIds  String[] @default([])
  source     String   @default("manual") // "manual" | "smart-capture"
  createdAt  DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, occurredAt])
  @@index([projectId])
}

// Read-later: articles/tweets saved from the share sheet or in-app, stored
// as sanitized reader-mode HTML with user highlights.
model ReaderItem {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  url          String
  title        String
  byline       String?
  siteName     String?
  excerpt      String?
  imageUrl     String?
  contentHtml  String      @default("") // sanitized reader-mode HTML
  wordCount    Int         @default(0)
  savedAt      DateTime    @default(now())
  readAt       DateTime?
  archivedAt   DateTime?
  kindleSentAt DateTime? // last successful email to the Kindle address
  kindleError  String?
  highlights   Highlight[]

  @@index([userId, archivedAt, savedAt])
}

// Mood board: anything you liked (image, video, song, product, link, note),
// sent from the share sheet, the Chrome extension, or pasted in the app.
// Remote images are re-hosted to Blob so the board never rots when a CDN
// link expires; width/height/color let the grid lay out before images load.
model BoardItem {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        String // "image" | "video" | "music" | "product" | "link" | "note"
  url         String? // source page
  title       String?
  note        String? // shared text or your own words
  siteName    String?
  imageUrl    String?
  imageWidth  Int?
  imageHeight Int?
  color       String? // dominant color, "#rrggbb", placeholder while loading
  price       String? // products: "$129.00"
  via         String   @default("app") // "app" | "shortcut" | "extension" | "share" | "rec"
  savedAt     DateTime @default(now())

  @@index([userId, savedAt])
}

// One row per user: the taste profile Claude writes from the board, plus the
// state of the latest recommendation run (the UI polls it while generating).
model BoardTaste {
  userId      String    @id
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile     String? // 2-4 sentence summary of what the board says about you
  status      String    @default("idle") // "idle" | "generating" | "error"
  error       String?
  startedAt   DateTime?
  generatedAt DateTime?
}

// A recommended thing, found with web search so the link is real. Saving it
// copies it onto the board; saved and dismissed recs steer the next run.
model BoardRec {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        String // same kinds as BoardItem
  title       String
  creator     String? // artist, brand, director, author
  reason      String // why it fits, citing things on the board
  url         String?
  imageUrl    String?
  siteName    String?
  price       String?
  status      String   @default("new") // "new" | "saved" | "dismissed"
  boardItemId String?
  createdAt   DateTime @default(now())

  @@index([userId, status, createdAt])
}

model Highlight {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId    String
  item      ReaderItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  text      String
  note      String?
  createdAt DateTime   @default(now())

  @@index([itemId])
  @@index([userId, createdAt])
}

// Web-push subscriptions (one per installed device/browser). Additive table;
// rows die naturally when a push returns 404/410 and we prune them.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model MagicLinkToken {
  id        String    @id @default(cuid())
  token     String    @unique
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@index([expiresAt])
}

// Dating: people you're seeing. Notes to remember, a timeline you rate as it
// goes, texts synced from the Mac (scripts/dating-messages-sync.ts) or pasted,
// and what each one taught you. Additive tables; needs a prod db push.
model DatingPerson {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  // Normalized phones (+15551234567) / lowercased emails used to match iMessage threads.
  handles       String[]  @default([])
  stage         String    @default("talking") // "talking" | "dating" | "exclusive" | "paused" | "ended"
  metVia        String? // "Hinge", "friends", "bar"
  metAt         DateTime?
  endedAt       DateTime?
  age           Int?
  city          String?
  work          String?
  remember      String[]  @default([]) // quick facts: family, favorites, plans
  greenFlags    String[]  @default([])
  redFlags      String[]  @default([])
  notes         String?
  lessons       String? // what this one taught you
  insights      Json? // last Claude read of the thread: { summary, remember, greenFlags, redFlags, lessons, ideas }
  insightsAt    DateTime?
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  events   DatingEvent[]
  messages DatingMessage[]

  @@index([userId, stage])
}

model DatingEvent {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  personId   String
  person     DatingPerson @relation(fields: [personId], references: [id], onDelete: Cascade)
  occurredAt DateTime
  kind       String // "date" | "milestone" | "call" | "conflict" | "note"
  title      String
  notes      String?
  vibe       Int? // 1-10, how it felt; plotted over time
  createdAt  DateTime     @default(now())

  @@index([personId, occurredAt])
}

model DatingMessage {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  personId   String
  person     DatingPerson @relation(fields: [personId], references: [id], onDelete: Cascade)
  sentAt     DateTime
  fromMe     Boolean
  text       String
  source     String       @default("imessage") // "imessage" | "paste"
  // iMessage guid, or "paste:<hash>" so re-imports dedupe.
  externalId String
  createdAt  DateTime     @default(now())

  @@unique([userId, externalId])
  @@index([personId, sentAt])
}
